# regexped must be built first: run `make` in the repo root.
#
# A FastEdge HTTP application in Go, built as a COMPONENT with componentize-go.
# Four steps: compile the patterns into a component (plus its .wit), generate
# the Go bindings for the app's world, build the app as a wasi:http guest
# component, compose the two. The last step is `regexped merge`, which
# dispatches on wasm_format and calls `wac` for a component.
#
# There is no regexped Go stub on this route: componentize-go generates the
# bindings from the .wit regexped writes, and the app calls them directly.
REGEXPED        := ../../../regexped
COMPONENTIZE_GO ?= componentize-go
GO_MIN          := 1.27.1
COMPONENT       := uaparser.wasm
WIT             := uaparser.wit
WIT_DEP         := wit/deps/regexped-uaparser/$(WIT)
# Generated by `componentize-go bindings`, beside go.mod and go.sum; it stands
# for the generated packages (regexped_uaparser_*/, wasi_*/) as the target.
BINDINGS        := wit_exports.go
APP_SRC         := $(wildcard export_wasi_http_incoming_handler/*.go)
GUEST           := main.wasm
FINAL           := ua-parser.wasm
PORT            ?= 8080
URL             := http://127.0.0.1:$(PORT)/

.PHONY: all check-tools compile bindings build compose serve run test clean

all: compose

# componentize-go needs Go 1.27.1 or later. With an older Go on PATH, let the
# go command fetch one: GOTOOLCHAIN=go1.27.3 make
# Run by the two recipes that call componentize-go, not as a prerequisite: a
# phony prerequisite runs every time, so `make run` on a finished build would
# have demanded the tools too.
check-tools:
	@command -v $(COMPONENTIZE_GO) >/dev/null || { \
	  echo "error: $(COMPONENTIZE_GO) not found: install componentize-go (see README.md), or pass COMPONENTIZE_GO=<path>" >&2; exit 1; }
	@v=$$(go env GOVERSION 2>/dev/null | sed 's/^go//'); \
	if [ -z "$$v" ] || [ "$$(printf '%s\n%s\n' $(GO_MIN) "$$v" | sort -V | head -1)" != "$(GO_MIN)" ]; then \
	  echo "error: componentize-go needs Go $(GO_MIN) or later, found $${v:-none}; run: GOTOOLCHAIN=go1.27.3 make" >&2; exit 1; fi

# Step 1 – compile the patterns into a component, plus the sibling .wit.
# Both come from ONE compile: a grouped target (`&:`, GNU make 4.3 or later).
$(COMPONENT) $(WIT) &: regexped.yaml $(REGEXPED)
	$(REGEXPED) compile --config=regexped.yaml

compile: $(COMPONENT)

# Step 2 – generate the Go bindings for wit/world.wit, whose imports are the
# component's interfaces: its .wit goes into wit/deps first. componentize-go
# rewrites go.mod too; `go mod tidy` fetches the runtime package it names and
# puts go.mod back as committed. go.mod and go.sum are committed because
# without them this directory would belong to the repository's own module,
# and a `go mod tidy` at the repository root would take on this example's
# dependency and Go version.
$(WIT_DEP): $(WIT)
	mkdir -p $(dir $@)
	cp $(WIT) $@

$(BINDINGS): $(WIT_DEP) wit/world.wit
	@$(MAKE) --no-print-directory check-tools
	$(COMPONENTIZE_GO) -d wit -w ua-parser bindings --format
	go mod tidy

bindings: $(BINDINGS)

# Step 3 – build the app as a GUEST component exporting wasi:http.
$(GUEST): $(BINDINGS) $(APP_SRC)
	@$(MAKE) --no-print-directory check-tools
	$(COMPONENTIZE_GO) -d wit -w ua-parser build -o $(GUEST)

build: $(GUEST)

# Step 4 – compose the app with the regexp component. Until this runs the app
# has an unsatisfied import. The result is what FastEdge runs.
$(FINAL): $(GUEST) $(COMPONENT)
	$(REGEXPED) merge --config=regexped.yaml --main=$(GUEST) $(COMPONENT)

compose: $(FINAL)

# Serve the app locally until Ctrl-C. -Scli grants the wasi:cli imports the Go
# runtime brings in; FastEdge provides them.
serve: $(FINAL)
	wasmtime serve -Scli --addr 127.0.0.1:$(PORT) $(FINAL)

# Serve the app in the background, POST each sample, stop the server.
run: $(FINAL)
	@if curl -s -o /dev/null $(URL); then \
	  echo "port $(PORT) is in use: make run PORT=<another>"; exit 1; fi; \
	wasmtime serve -Scli --addr 127.0.0.1:$(PORT) $(FINAL) 2>.serve.log & pid=$$!; \
	trap 'kill $$pid 2>/dev/null' EXIT; \
	until curl -s -o /dev/null $(URL); do \
	  kill -0 $$pid 2>/dev/null || { cat .serve.log; exit 1; }; sleep 0.2; done; \
	for ua in \
	    'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 Edg/120.0.2210.91' \
	    'Mozilla/5.0 (iPhone; CPU iPhone OS 17_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.2 Mobile/15E148 Safari/604.1' \
	    'Mozilla/5.0 (Linux; Android 13; SM-X700) AppleWebKit/537.36 (KHTML, like Gecko) SamsungBrowser/23.0 Chrome/115.0.0.0 Safari/537.36' \
	    'Mozilla/5.0 AppleWebKit/537.36 (KHTML, like Gecko; compatible; Googlebot/2.1; +http://www.google.com/bot.html) Chrome/120.0.6099.71 Safari/537.36' \
	    'curl/8.4.0'; do \
	  echo "$$ua"; printf '  → '; curl -s --data-binary "$$ua" $(URL); \
	done

# Run ua-parser.wasm under the FastEdge runtime itself — fastedge-run, through
# @gcoredev/fastedge-test — and assert every sample's answer (test.mjs). Run
# `npm install` once first; this Makefile installs nothing.
test: $(FINAL)
	@test -d node_modules/@gcoredev/fastedge-test || { \
	  echo "error: run 'npm install' first: it installs @gcoredev/fastedge-test" >&2; exit 1; }
	npm test

clean:
	rm -f $(COMPONENT) $(WIT) $(GUEST) $(FINAL) $(BINDINGS) .serve.log
	rm -rf regexped_uaparser_*/ wasi_*/ $(dir $(WIT_DEP))
